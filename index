!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Viajes Chile - Descubre los destinos más increíbles de Chile">
  <title>Viajes Chile</title>

  <!-- Bootstrap 5.3.3 CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

  <!-- Font Awesome 6.5.1 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Google Fonts: Montserrat + Open Sans -->
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;700;900&family=Open+Sans:wght@300;400;600&display=swap" rel="stylesheet">

  <!-- Estilos propios -->
  <link rel="stylesheet" href="assets/css/style.css">
</head>
<body>

  <!-- ===================== NAVBAR ===================== -->
  <nav class="navbar navbar-expand-lg navbar-dark fixed-top" id="navbar">
    <div class="container">
      <!-- Logo con favicon -->
      <a class="navbar-brand d-flex align-items-center gap-2" href="#inicio">
        <i class="fa-solid fa-earth-americas fa-lg text-cyan"></i>
        <span class="brand-name">Viajes Chile</span>
      </a>

      <!-- Botón hamburguesa responsive -->
      <button class="navbar-toggler border-0" type="button"
              data-bs-toggle="collapse" data-bs-target="#navMenu"
              aria-controls="navMenu" aria-expanded="false"
              aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <!-- Links de navegación -->
      <div class="collapse navbar-collapse" id="navMenu">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link" href="#inicio">Inicio</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#quienes-somos">Quiénes Somos</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#destacados">Destacados</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#contacto">Contacto</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- ===================== CAROUSEL ===================== -->
  <section id="inicio">
    <div id="carouselViajes" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="4000">

      <!-- Indicadores -->
      <div class="carousel-indicators">
        <button type="button" data-bs-target="#carouselViajes" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#carouselViajes" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#carouselViajes" data-bs-slide-to="2" aria-label="Slide 3"></button>
      </div>

      <!-- Slides -->
      <div class="carousel-inner">

        <!-- Slide 1: Atacama / Norte -->
        <div class="carousel-item active">
          <img src="https://images.unsplash.com/photo-1544464459-c76f1660e8c0?w=1400&q=80"
               class="d-block w-100 carousel-img" alt="Desierto de Atacama">
          <div class="carousel-caption d-none d-md-block">
            <h2 class="carousel-title">Desierto de Atacama</h2>
            <p class="carousel-subtitle">El desierto más árido del mundo, lleno de maravillas</p>
          </div>
        </div>

        <!-- Slide 2: Torres del Paine -->
        <div class="carousel-item">
          <img src="https://images.unsplash.com/photo-1501854140801-50d01698950b?w=1400&q=80"
               class="d-block w-100 carousel-img" alt="Torres del Paine">
          <div class="carousel-caption d-none d-md-block">
            <h2 class="carousel-title">Torres del Paine</h2>
            <p class="carousel-subtitle">La joya de la Patagonia chilena</p>
          </div>
        </div>

        <!-- Slide 3: Valparaíso -->
        <div class="carousel-item">
          <img src="https://images.unsplash.com/photo-1508739773434-c26b3d09e071?w=1400&q=80"
               class="d-block w-100 carousel-img" alt="Valparaíso">
          <div class="carousel-caption d-none d-md-block">
            <h2 class="carousel-title">Valparaíso</h2>
            <p class="carousel-subtitle">Ciudad patrimonio, arte y cultura en cada cerro</p>
          </div>
        </div>

      </div>

      <!-- Controles prev/next -->
      <button class="carousel-control-prev" type="button" data-bs-target="#carouselViajes" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Anterior</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#carouselViajes" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Siguiente</span>
      </button>
    </div>
  </section>

  <!-- ===================== QUIÉNES SOMOS ===================== -->
  <!-- Sección oculta en pantallas pequeñas (d-none d-md-block) -->
  <section id="quienes-somos" class="section-dark d-none d-md-block">
    <div class="container py-5">

      <!-- Título de sección -->
      <h2 class="section-title text-center mb-5">¿QUIÉNES SOMOS?</h2>

      <!-- 3 columnas con favicons Bootstrap -->
      <div class="row g-4">

        <!-- Col 1 -->
        <div class="col-12 col-md-4">
          <div class="quien-card text-center">
            <div class="quien-icon mb-3">
              <i class="fa-solid fa-map-location-dot fa-2x text-cyan"></i>
            </div>
            <p class="quien-text">
              Somos una agencia de viajes especializada en destinos chilenos,
              con más de 15 años de experiencia llevando a viajeros a descubrir
              los paisajes más impresionantes de nuestro país. Desde el norte
              desértico hasta los glaciares del sur, conocemos cada rincón.
            </p>
          </div>
        </div>

        <!-- Col 2 -->
        <div class="col-12 col-md-4">
          <div class="quien-card text-center">
            <div class="quien-icon mb-3">
              <i class="fa-solid fa-compass fa-2x text-cyan"></i>
            </div>
            <p class="quien-text">
              Nuestro equipo de guías expertos diseña itinerarios personalizados
              para cada tipo de viajero: aventureros, familias, parejas o grupos.
              Nos comprometemos a brindar experiencias únicas e irrepetibles
              que conecten a las personas con la naturaleza y cultura de Chile.
            </p>
          </div>
        </div>

        <!-- Col 3 -->
        <div class="col-12 col-md-4">
          <div class="quien-card text-center">
            <div class="quien-icon mb-3">
              <i class="fa-solid fa-star fa-2x text-cyan"></i>
            </div>
            <p class="quien-text">
              Con más de 10.000 viajeros satisfechos, somos líderes en turismo
              nacional. Ofrecemos paquetes todo incluido, transporte seguro y
              alojamiento de calidad. Nuestra misión es que cada viaje sea
              una aventura memorable que quieras repetir.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================== DESTACADOS ===================== -->
  <section id="destacados" class="section-black">
    <div class="container py-5">

      <!-- Título -->
      <h2 class="section-title text-center mb-5">DESTACADOS</h2>

      <!-- 4 cards en grilla responsive -->
      <div class="row g-3">

        <!-- Card 1 -->
        <div class="col-12 col-sm-6 col-lg-3">
          <div class="card destino-card h-100 border-0"
               data-bs-toggle="tooltip"
               data-bs-placement="top"
               title="Visita Torres del Paine">
            <img src="https://images.unsplash.com/photo-1501854140801-50d01698950b?w=600&q=80"
                 class="card-img-top destino-img" alt="Torres del Paine">
            <div class="card-body card-body-cyan">
              <h5 class="card-title-dest">Torres del Paine</h5>
              <p class="card-text-dest">
                Trekking y naturaleza en uno de los parques nacionales más
                espectaculares del mundo. Una experiencia que cambia la vida.
              </p>
            </div>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="col-12 col-sm-6 col-lg-3">
          <div class="card destino-card h-100 border-0"
               data-bs-toggle="tooltip"
               data-bs-placement="top"
               title="Explora el Valle de la Luna">
            <img src="https://images.unsplash.com/photo-1544464459-c76f1660e8c0?w=600&q=80"
                 class="card-img-top destino-img" alt="Atacama">
            <div class="card-body card-body-cyan">
              <h5 class="card-title-dest">Valle de la Luna</h5>
              <p class="card-text-dest">
                Un paisaje lunar en el corazón del Atacama. Salares, géiseres
                y cielos estrellados únicos en el planeta tierra.
              </p>
            </div>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="col-12 col-sm-6 col-lg-3">
          <div class="card destino-card h-100 border-0"
               data-bs-toggle="tooltip"
               data-bs-placement="top"
               title="Descubre los Lagos del Sur">
            <img src="https://images.unsplash.com/photo-1508739773434-c26b3d09e071?w=600&q=80"
                 class="card-img-top destino-img" alt="Lagos del Sur">
            <div class="card-body card-body-cyan">
              <h5 class="card-title-dest">Lagos del Sur</h5>
              <p class="card-text-dest">
                Puerto Varas, Llanquihue y Villarrica te esperan con sus aguas
                cristalinas y volcanes coronados de nieve.
              </p>
            </div>
          </div>
        </div>

        <!-- Card 4 -->
        <div class="col-12 col-sm-6 col-lg-3">
          <div class="card destino-card h-100 border-0"
               data-bs-toggle="tooltip"
               data-bs-placement="top"
               title="Explora la Carretera Austral">
            <img src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=600&q=80"
                 class="card-img-top destino-img" alt="Carretera Austral">
            <div class="card-body card-body-cyan">
              <h5 class="card-title-dest">Carretera Austral</h5>
              <p class="card-text-dest">
                La ruta más épica de Sudamérica. Fiordos, bosques milenarios
                y pueblos remotos te esperan en esta aventura sin igual.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================== CONTACTO ===================== -->
  <section id="contacto" class="section-black">
    <div class="container py-5">

      <h2 class="section-title text-center mb-5">CONTACTO</h2>

      <div class="row justify-content-center">
        <div class="col-12 col-md-8">
          <form id="formContacto" novalidate>

            <!-- Nombre -->
            <div class="mb-3">
              <label for="nombre" class="form-label label-contact">Nombre</label>
              <input type="text" class="form-control input-contact" id="nombre"
                     placeholder="Tu nombre completo" required>
            </div>

            <!-- Asunto -->
            <div class="mb-3">
              <label for="asunto" class="form-label label-contact">Asunto</label>
              <input type="text" class="form-control input-contact" id="asunto"
                     placeholder="¿En qué podemos ayudarte?" required>
            </div>

            <!-- Mensaje -->
            <div class="mb-4">
              <label for="mensaje" class="form-label label-contact">Mensaje</label>
              <textarea class="form-control input-contact" id="mensaje"
                        rows="5" placeholder="Escribe tu mensaje aquí..." required></textarea>
            </div>

            <!-- Botón enviar -->
            <div>
              <button type="submit" class="btn btn-cyan-custom"
                      data-bs-toggle="tooltip"
                      data-bs-placement="right"
                      title="Haz clic para enviar tu mensaje">
                Enviar
              </button>
            </div>

          </form>

          <!-- Alerta de confirmación (oculta por defecto) -->
          <div id="alertaEnvio" class="alert alert-success mt-3 d-none" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>
            ¡Mensaje enviado con éxito! Te contactaremos pronto.
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ===================== FOOTER ===================== -->
  <footer class="footer-cyan">
    <div class="container py-3">
      <div class="row align-items-center">

        <!-- Nombre empresa -->
        <div class="col-12 col-md-6 text-center text-md-start mb-2 mb-md-0">
          <span class="footer-brand">VIAJES CHILE</span>
        </div>

        <!-- Redes sociales -->
        <div class="col-12 col-md-6 text-center text-md-end">
          <a href="#" class="footer-icon" aria-label="GitHub">
            <i class="fa-brands fa-github fa-lg"></i>
          </a>
          <a href="#" class="footer-icon" aria-label="LinkedIn">
            <i class="fa-brands fa-linkedin fa-lg"></i>
          </a>
          <a href="#" class="footer-icon" aria-label="Twitter / X">
            <i class="fa-brands fa-x-twitter fa-lg"></i>
          </a>
          <a href="#" class="footer-icon" aria-label="Facebook">
            <i class="fa-brands fa-facebook fa-lg"></i>
          </a>
        </div>

      </div>
    </div>
  </footer>

  <!-- Bootstrap 5.3.3 JS Bundle (incluye Popper) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Script propio -->
  <script src="assets/js/main.js"></script>

</body>
</html>
